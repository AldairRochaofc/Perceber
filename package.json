    "gsap": "3.13.0",
    "lucide-react": "0.560.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
